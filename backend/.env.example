PORT=5050
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=quiz_integrity_guard
# Automated tests always use a separate database. It must end in _test.
TEST_DB_NAME=quiz_integrity_guard_test
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Used only by the local development student seed. Choose a private password.
NODE_ENV=development
TEST_STUDENT_NAME=Demo Student
TEST_STUDENT_EMAIL=student.demo@example.com
TEST_STUDENT_PASSWORD=
# Exact portal origins; add the extension origin through CHROME_EXTENSION_ID after loading the unpacked extension.
CORS_ORIGIN=http://localhost:5005,http://127.0.0.1:5005
CHROME_EXTENSION_ID=
