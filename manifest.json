{
  "manifest_version": 3,
  "name": "Exam Monitor",
  "version": "1.1.0",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "http://localhost:5005/*",
    "http://127.0.0.1:5005/*",
    "http://localhost:5050/*",
    "http://127.0.0.1:5050/*"
  ],
  "action": {
    "default_title": "Exam Monitor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "http://localhost:5005/*",
        "http://127.0.0.1:5005/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
